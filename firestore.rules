rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /warrantyContacts/{order} {
      // Any signed-in teammate can read and update. Tighten with an email domain check if desired:
      //   && request.auth.token.email.matches('.*@metapcs[.]com')
      allow read, write: if request.auth != null;
    }
  }
}
