{
  "manifest_version": 3,
  "name": "Warranty Upsell Tracker",
  "version": "2.1.0",
  "description": "Shared team log of who contacted which Shopify orders about extended warranty. Shows the contacter on the Shopify orders list.",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "sidePanel"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://admin.shopify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Warranty Upsell Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}